# Absolute path on the macOS host to expose as /home/dev/workspace.
WORKSPACE_PATH=/absolute/path/to/your/workspace
PERSONAL_WORKSPACE_PATH=/absolute/path/to/personal/projects
PASSWORD=

# Stable device name on your Tailscale network.
TS_HOSTNAME=cc-dev

# Absolute CleanShot media path; source and container target stay identical.
CLEANSHOT_MEDIA_PATH=/absolute/path/to/screenshots
