# dev 用户的 SSH 密码，启动前必须设置。
PASSWORD=

# 在 Tailscale 网络中使用的固定设备名。
TS_HOSTNAME=cc-dev

# 宿主机路径（必须是绝对路径；Compose 不会展开 "~"）。
# 开发机使用的 Mac 工作区。
WORKSPACE_DIR=/Users/you/workspace
# 工作区以外的运行时数据：remote-shell 的机器目录（remote-shell/<机器>/）、
# 开发机用的客户端（bin/）、状态（state/）和日志（logs/）。
RUNTIME_DIR=/Users/you/.cc-runtime
# 在每台开发机中挂载到相同路径，~/Downloads 是指向它的链接。
DOWNLOADS_DIR=/Users/you/Downloads

# 可选：开发镜像，以及各开发机 ~/.cache 所用的 Docker 卷和子路径
# （首次启动时创建）。
# DEV_IMAGE=ghcr.io/zeke-chin/cc-runtime:latest
# CACHE_VOLUME=cc-runtime-cache
# DEV_PENNSYLVANIA_CACHE=dev-pennsylvania
# DEV_CALIFORNIA_CACHE=dev-california

# 可选：宿主机截图目录（例如 CleanShot 的媒体目录）。目录存在时以相同路径只读挂进
# 每台开发机，把截图的完整路径粘贴给 agent 就能直接用。在工作区或下载目录里的不用配置。
# HOST_SCREENSHOTS_PATH=/Users/you/Pictures/Screenshots

# 可选：remote-shell（开发机里 Claude Code 的 Bash 命令在 Mac 上执行，见 docs/remote-shell.md）。
# Mac 上 remote-shell 服务监听的端口（只绑定 127.0.0.1）；改了要同时改网关配置里的 tunnel。
# REMOTE_SHELL_PORT=47100

# 可选：定时任务（cc-runtime schedule）。按天运行的任务可在这里覆盖默认时刻：
#   <任务>_TIME    HH:MM
#   <任务>_TZ      时刻所在的时区（IANA 名称）。launchd 只按 Mac 的本地时区触发，安装时会换算；
#                  Mac 换了时区或进出夏令时，status 和 schedule list 会提示「需重装」
#   <任务>_JITTER  秒，0–60，在目标时刻前后随机
# 改了这几项要重新运行 cc-runtime schedule install。
# wake-claude：每天在开发机里发一条简短请求唤醒 Claude。PROMPT 和 MACHINES 在每次运行时读取。
# WAKE_CLAUDE_TIME=08:30
# WAKE_CLAUDE_TZ=Asia/Shanghai
# WAKE_CLAUDE_JITTER=10
# WAKE_CLAUDE_PROMPT=只回复 ok
# WAKE_CLAUDE_MACHINES=dev-pennsylvania
