# -----------------
# Zsh configuration
# -----------------

#
# Environment
#

# Claude Code、Antigravity 等用户级工具在 ~/.local/bin；装了 agy 时让包装器排在前面。
if [[ -x $HOME/.local/bin/agy ]]; then
  export PATH="/opt/cc-runtime/antigravity:$HOME/.local/bin:$PATH"
else
  export PATH="$HOME/.local/bin:$PATH"
fi

# 镜像已生成 en_US.UTF-8；这里再导出一次，防止被外部环境覆盖成不存在的 locale。
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# SSH 客户端会带来自己的终端类型（如 Ghostty 的 xterm-ghostty）。容器缺少对应
# terminfo 时，zsh 无法移动光标重绘命令行，输入会重复回显。此时回退到通用类型。
if [[ -n $TERM ]] && ! infocmp "$TERM" &>/dev/null; then
  export TERM=xterm-256color
fi

#
# History
#

# Remove older command from the history if a duplicate is to be added.
setopt HIST_IGNORE_ALL_DUPS
bindkey -e
WORDCHARS=${WORDCHARS//[\/]}
# zsh-users/zsh-autosuggestions is the last module in your ~/.zimrc.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# ------------------
# Initialize modules
# ------------------

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# Download zimfw plugin manager if missing.
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  if (( ${+commands[curl]} )); then
    curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    mkdir -p ${ZIM_HOME} && wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi
# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi
# Initialize modules.
source ${ZIM_HOME}/init.zsh

# ------------------------------
# Post-init module configuration
# ------------------------------

#
# zsh-history-substring-search
#

zmodload -F zsh/terminfo +p:terminfo
# Bind ^[[A/^[[B manually so up/down works both before and after zle-line-init
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
for key ('k') bindkey -M vicmd ${key} history-substring-search-up
for key ('j') bindkey -M vicmd ${key} history-substring-search-down
unset key
# }}} End configuration added by Zim install

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
(( ! ${+functions[p10k]} )) || p10k finalize

# zoxide：z 跳转目录，zi 交互选择。需要在 compinit 之后初始化。
(( ! ${+commands[zoxide]} )) || eval "$(zoxide init zsh)"

# fzf：Ctrl-R 搜索历史，Ctrl-T 搜索文件
(( ! ${+commands[fzf]} )) || source <(fzf --zsh)

alias claude="claude --dangerously-skip-permissions"
alias zshc="vim ~/.zshrc"
alias zshcc="exec zsh"
alias j="zi"
alias gcm="git commit -m "

# Claude Code 的 Bash 工具（CLAUDECODE=1）按 bash 的习惯执行命令：未加引号的变量
# 按空格拆分、未匹配的通配符原样保留、重定向可以覆盖已有文件。交互终端不受影响。
if [[ -n $CLAUDECODE ]]; then
  setopt sh_word_split clobber
  unsetopt nomatch
fi
